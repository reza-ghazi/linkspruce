{
  "name": "linkspruce",
  "version": "1.0.0",
  "private": true,
  "description": "LinkSpruce \u2014 Bookmark Cleaner & Organizer (Chrome extension)",
  "type": "module",
  "license": "MIT",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "node scripts/build.mjs",
    "build:dev": "node scripts/build.mjs --dev",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "lint": "eslint .",
    "test": "vitest run",
    "test:watch": "vitest",
    "build:e2e": "node scripts/build.mjs --e2e",
    "test:e2e": "node scripts/build.mjs --e2e && node scripts/build.mjs && playwright test",
    "package": "node scripts/package.mjs",
    "verify": "npm run typecheck && npm run lint && npm test && npm run build && npm run test:e2e && npm run package"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.1",
    "@types/chrome": "^0.3.6",
    "@types/node": "^22.20.5",
    "esbuild": "^0.28.2",
    "eslint": "^10.13.0",
    "globals": "^17.13.0",
    "typescript": "~6.0",
    "typescript-eslint": "^8.72.0",
    "vitest": "^5.0.5"
  },
  "homepage": "https://github.com/reza-ghazi/linkspruce",
  "repository": {
    "type": "git",
    "url": "https://github.com/reza-ghazi/linkspruce.git"
  },
  "bugs": {
    "url": "https://github.com/reza-ghazi/linkspruce/issues"
  }
}
